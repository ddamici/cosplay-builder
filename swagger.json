{
  "openapi": "3.0.3",
  "info": {
    "title": "FanCon Cosplay Builder API",
    "description": "API for building custom cosplay outfits with character selection, costume pieces, and purchase links",
    "version": "1.0.0",
    "contact": {
      "name": "FanCon.ai",
      "url": "https://fancon.ai"
    }
  },
  "servers": [
    {
      "url": "https://api.fancon.ai/cosplay-builder",
      "description": "Production server"
    },
    {
      "url": "http://localhost:8000/cosplay-builder",
      "description": "Local development server"
    }
  ],
  "tags": [
    {
      "name": "Characters",
      "description": "Browse and search cosplay characters"
    },
    {
      "name": "Appearances",
      "description": "Character appearances and costume variations"
    },
    {
      "name": "Costume Pieces",
      "description": "Individual costume pieces with purchase links"
    },
    {
      "name": "Builds",
      "description": "User's saved costume builds"
    },
    {
      "name": "Photo Rendering",
      "description": "AI photo rendering (future feature)"
    }
  ],
  "paths": {
    "/characters": {
      "get": {
        "tags": ["Characters"],
        "summary": "Get all characters",
        "description": "Returns a paginated list of characters available for cosplay building. Supports search and filtering.",
        "operationId": "getCharacters",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "description": "Search by character name (case-insensitive)",
            "required": false,
            "schema": {
              "type": "string",
              "example": "yelena"
            }
          },
          {
            "name": "franchise",
            "in": "query",
            "description": "Filter by franchise (e.g., Marvel, Star Wars)",
            "required": false,
            "schema": {
              "type": "string",
              "example": "Marvel"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number for pagination",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of items per page",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CharacterListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/characters/{character_id}": {
      "get": {
        "tags": ["Characters"],
        "summary": "Get character by ID",
        "description": "Returns a single character with all appearances",
        "operationId": "getCharacterById",
        "parameters": [
          {
            "name": "character_id",
            "in": "path",
            "description": "Character ID",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 3
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CharacterDetail"
                }
              }
            }
          },
          "404": {
            "description": "Character not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/appearances/{appearance_id}/pieces": {
      "get": {
        "tags": ["Costume Pieces"],
        "summary": "Get costume pieces for appearance",
        "description": "Returns all costume pieces for a specific appearance, including purchase links",
        "operationId": "getCostumePieces",
        "parameters": [
          {
            "name": "appearance_id",
            "in": "path",
            "description": "Appearance ID",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CostumePiecesResponse"
                }
              }
            }
          },
          "404": {
            "description": "Appearance not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/builds": {
      "post": {
        "tags": ["Builds"],
        "summary": "Create a new costume build",
        "description": "Creates a new costume build for logged-in or anonymous users",
        "operationId": "createBuild",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBuildRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Build created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BuildResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/builds/{build_id}": {
      "get": {
        "tags": ["Builds"],
        "summary": "Get build by ID",
        "description": "Returns a costume build with all selected pieces",
        "operationId": "getBuildById",
        "parameters": [
          {
            "name": "build_id",
            "in": "path",
            "description": "Build ID",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 789
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BuildDetail"
                }
              }
            }
          },
          "404": {
            "description": "Build not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Builds"],
        "summary": "Delete a build",
        "description": "Deletes a costume build",
        "operationId": "deleteBuild",
        "parameters": [
          {
            "name": "build_id",
            "in": "path",
            "description": "Build ID",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 789
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Build deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Build deleted successfully"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Build not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/builds/{build_id}/pieces": {
      "put": {
        "tags": ["Builds"],
        "summary": "Update selected pieces",
        "description": "Updates which costume pieces are selected in a build",
        "operationId": "updateBuildPieces",
        "parameters": [
          {
            "name": "build_id",
            "in": "path",
            "description": "Build ID",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 789
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateBuildPiecesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Build updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BuildResponse"
                }
              }
            }
          },
          "404": {
            "description": "Build not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/builds/{build_id}/upload-photo": {
      "post": {
        "tags": ["Photo Rendering"],
        "summary": "Upload user photo",
        "description": "Upload user's photo for AI costume rendering (future feature)",
        "operationId": "uploadPhoto",
        "parameters": [
          {
            "name": "build_id",
            "in": "path",
            "description": "Build ID",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 789
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "photo": {
                    "type": "string",
                    "format": "binary",
                    "description": "User's photo file (JPEG, PNG)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Photo uploaded successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "example": 789
                    },
                    "uploaded_photo_url": {
                      "type": "string",
                      "example": "https://fancon.s3.amazonaws.com/uploads/789.jpg"
                    },
                    "status": {
                      "type": "string",
                      "example": "processing"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/builds/{build_id}/render": {
      "get": {
        "tags": ["Photo Rendering"],
        "summary": "Get rendered photo",
        "description": "Get AI-rendered photo result (future feature)",
        "operationId": "getRenderedPhoto",
        "parameters": [
          {
            "name": "build_id",
            "in": "path",
            "description": "Build ID",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 789
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Rendered photo available",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "integer",
                      "example": 789
                    },
                    "uploaded_photo_url": {
                      "type": "string",
                      "example": "https://fancon.s3.amazonaws.com/uploads/789.jpg"
                    },
                    "rendered_photo_url": {
                      "type": "string",
                      "example": "https://fancon.s3.amazonaws.com/renders/789.jpg"
                    },
                    "status": {
                      "type": "string",
                      "enum": ["processing", "completed", "failed"],
                      "example": "completed"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Build not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/my-builds": {
      "get": {
        "tags": ["Builds"],
        "summary": "Get user's builds",
        "description": "Returns all builds for logged-in user or anonymous session",
        "operationId": "getMyBuilds",
        "parameters": [
          {
            "name": "user_id",
            "in": "query",
            "description": "User ID (for logged-in users)",
            "required": false,
            "schema": {
              "type": "integer",
              "example": 12345
            }
          },
          {
            "name": "session_id",
            "in": "query",
            "description": "Session ID (for anonymous users)",
            "required": false,
            "schema": {
              "type": "string",
              "example": "session_abc123xyz"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MyBuildsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - must provide user_id or session_id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Character": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 3
          },
          "name": {
            "type": "string",
            "example": "Yelena Belova"
          },
          "image_url": {
            "type": "string",
            "format": "uri",
            "example": "https://fancon.s3.us-east-2.amazonaws.com/characters/yelena%20belova.webp"
          },
          "franchise": {
            "type": "string",
            "example": "Marvel"
          },
          "category": {
            "type": "string",
            "example": "Superhero"
          }
        }
      },
      "Appearance": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "title": {
            "type": "string",
            "example": "Black Widow (2021)"
          },
          "outfit_name": {
            "type": "string",
            "example": "Tactical Gear"
          },
          "description": {
            "type": "string",
            "example": "Worn during main fight sequences"
          },
          "image_url": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "release_year": {
            "type": "integer",
            "example": 2021,
            "nullable": true
          }
        }
      },
      "CostumePiece": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 101
          },
          "piece_name": {
            "type": "string",
            "example": "White Jumpsuit"
          },
          "piece_type": {
            "type": "string",
            "enum": ["Clothing", "Accessory", "Wig", "Prop", "Footwear"],
            "example": "Clothing"
          },
          "difficulty_level": {
            "type": "string",
            "enum": ["Easy", "Medium", "Hard"],
            "example": "Medium",
            "nullable": true
          },
          "estimated_cost": {
            "type": "number",
            "format": "decimal",
            "example": 89.99,
            "nullable": true
          },
          "purchase_url": {
            "type": "string",
            "format": "uri",
            "example": "https://amazon.com/...",
            "nullable": true
          },
          "vendor_name": {
            "type": "string",
            "example": "Amazon",
            "nullable": true
          },
          "thumbnail_url": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "is_optional": {
            "type": "boolean",
            "example": false
          },
          "display_order": {
            "type": "integer",
            "example": 1
          },
          "notes": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "CharacterListResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Character"
            }
          },
          "pagination": {
            "type": "object",
            "properties": {
              "page": {
                "type": "integer",
                "example": 1
              },
              "limit": {
                "type": "integer",
                "example": 20
              },
              "total": {
                "type": "integer",
                "example": 50
              },
              "total_pages": {
                "type": "integer",
                "example": 3
              }
            }
          }
        }
      },
      "CharacterDetail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 3
          },
          "name": {
            "type": "string",
            "example": "Yelena Belova"
          },
          "image_url": {
            "type": "string",
            "format": "uri",
            "example": "https://fancon.s3.us-east-2.amazonaws.com/characters/yelena%20belova.webp"
          },
          "franchise": {
            "type": "string",
            "example": "Marvel"
          },
          "category": {
            "type": "string",
            "example": "Superhero"
          },
          "appearances": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Appearance"
            }
          }
        }
      },
      "CostumePiecesResponse": {
        "type": "object",
        "properties": {
          "appearance": {
            "$ref": "#/components/schemas/Appearance"
          },
          "pieces": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CostumePiece"
            }
          },
          "total_estimated_cost": {
            "type": "number",
            "format": "decimal",
            "example": 350.00
          }
        }
      },
      "CreateBuildRequest": {
        "type": "object",
        "required": ["cosplay_character_id", "costume_appearance_id"],
        "properties": {
          "cosplay_character_id": {
            "type": "integer",
            "example": 3
          },
          "costume_appearance_id": {
            "type": "integer",
            "example": 1
          },
          "build_name": {
            "type": "string",
            "example": "My Yelena Costume",
            "nullable": true
          },
          "user_id": {
            "type": "integer",
            "example": 12345,
            "nullable": true,
            "description": "FanCon user ID (null if anonymous)"
          },
          "session_id": {
            "type": "string",
            "example": "session_abc123xyz",
            "description": "Required if user_id is null (anonymous user)"
          },
          "selected_piece_ids": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "example": [101, 102, 103, 105]
          }
        }
      },
      "BuildResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 789
          },
          "cosplay_character_id": {
            "type": "integer",
            "example": 3
          },
          "costume_appearance_id": {
            "type": "integer",
            "example": 1
          },
          "build_name": {
            "type": "string",
            "example": "My Yelena Costume",
            "nullable": true
          },
          "total_cost": {
            "type": "number",
            "format": "decimal",
            "example": 245.99
          },
          "status": {
            "type": "string",
            "enum": ["draft", "completed", "purchased"],
            "example": "draft"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-03T19:41:00Z"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-03T19:41:00Z"
          }
        }
      },
      "BuildDetail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 789
          },
          "character": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "example": 3
              },
              "name": {
                "type": "string",
                "example": "Yelena Belova"
              }
            }
          },
          "appearance": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "example": 1
              },
              "title": {
                "type": "string",
                "example": "Black Widow (2021)"
              }
            }
          },
          "build_name": {
            "type": "string",
            "example": "My Yelena Costume",
            "nullable": true
          },
          "selected_pieces": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CostumePiece"
            }
          },
          "total_cost": {
            "type": "number",
            "format": "decimal",
            "example": 245.99
          },
          "uploaded_photo_url": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "rendered_photo_url": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": ["draft", "completed", "purchased"],
            "example": "draft"
          }
        }
      },
      "UpdateBuildPiecesRequest": {
        "type": "object",
        "required": ["selected_piece_ids"],
        "properties": {
          "selected_piece_ids": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "example": [101, 102, 105, 107]
          }
        }
      },
      "MyBuildsResponse": {
        "type": "object",
        "properties": {
          "builds": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "example": 789
                },
                "character_name": {
                  "type": "string",
                  "example": "Yelena Belova"
                },
                "appearance_title": {
                  "type": "string",
                  "example": "Black Widow (2021)"
                },
                "build_name": {
                  "type": "string",
                  "example": "My Yelena Costume",
                  "nullable": true
                },
                "total_cost": {
                  "type": "number",
                  "format": "decimal",
                  "example": 245.99
                },
                "status": {
                  "type": "string",
                  "example": "draft"
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time",
                  "example": "2026-11-03T19:41:00Z"
                }
              }
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Resource not found"
          },
          "detail": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  }
}
